==================== Задание 4. L7 балансировка (NGINX, active-backup) ====================

$ rm -f /etc/nginx/sites-enabled/default

$ cp /hw/nginx-highload.conf /etc/nginx/conf.d/highload.conf && cat /etc/nginx/conf.d/highload.conf
log_format upstreamlog '$time_local "$request" $status upstream=$upstream_addr upstream_status=$upstream_status';

upstream highload_backend {
    zone highload_backend 64k;
    server 127.0.0.1:8081 max_fails=7 fail_timeout=30s;
    server 127.0.0.1:8082 backup;
}

server {
    listen 127.0.0.1:8888;

    access_log /var/log/nginx/highload_access.log upstreamlog;
    error_log  /var/log/nginx/highload_error.log warn;

    location / {
        proxy_pass http://highload_backend;
        proxy_set_header X-high-load-test 123;
    }
}

